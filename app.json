{
  "expo": {
    "name": "Lojong",
    "slug": "lojong",
    "scheme": "lojong",
    "version": "1.6.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f0e8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nl.databrouwer.lojong"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f5f0e8"
      },
      "package": "nl.databrouwer.lojong"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8b5e3c",
          "sounds": []
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withFontScaleReload.js",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Java serialization protocol methods are invoked reflectively; R8 strips them otherwise. expo-notifications persists scheduled notifications via Serializable with custom writeObject/readObject (NotificationContent holds a non-serializable JSONObject), which breaks scheduling without these rules.\n-keepclassmembers class * implements java.io.Serializable {\n    static final long serialVersionUID;\n    private static final java.io.ObjectStreamField[] serialPersistentFields;\n    private void writeObject(java.io.ObjectOutputStream);\n    private void readObject(java.io.ObjectInputStream);\n    java.lang.Object writeReplace();\n    java.lang.Object readResolve();\n}"
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SloganOfTheDay",
              "label": "Slogan of the Day",
              "description": "Today's lojong slogan",
              "minWidth": "250dp",
              "minHeight": "60dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview.png"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c3df9f4b-1c33-427d-80da-cf7c7f88ab7b"
      }
    },
    "owner": "mbrodata"
  }
}
